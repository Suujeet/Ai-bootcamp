# OOP Program: Book Details

class Book:
    
    def __init__(self, title, author, price):
        self.title = title
        self.author = author
        self.price = price

    
    def display(self):
        print("Book Title :", self.title)
        print("Author     :", self.author)
        print("Price      : $", self.price)



book1 = Book("Python Programming", "Ram Krishna", 25)
book2 = Book("Data Structures", "Krishna Ram", 19)

print("Book 1 Details")
book1.display()

print("\nBook 2 Details")
book2.display()
